{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bestgres",
  "version": "0.3.1",
  "identifier": "com.bestgres.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bestgres",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LauriSarap/bestgres/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwRTdDRTdBREMyMjVBREMKUldUY1dpTGNlczduQVBmNDYyYlFieitlWWs4Qlkzb1FaTGhIZlV2Q0FnNEk0a2hzc2dSenlXNmwK"
    }
  }
}
